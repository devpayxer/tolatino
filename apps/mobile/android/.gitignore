# Llaves: nunca en el repo (guardián llavesFueraDelRepo). Viven cifradas en el llavero del servidor.
*.jks
*.keystore
*.p12
google-services.json
# 8c · La configuración de Firebase (solo mensajería) la escribe el CI de 8h desde el llavero; nunca en el repo.
app/src/*/res/values/firebase.xml
