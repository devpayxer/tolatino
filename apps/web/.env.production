# Public Supabase config (baked into the static client build).
# These are PUBLIC by design — the publishable key is browser-safe and the data
# is protected by Row Level Security (public read only; no write policies).
# To rotate: replace the values here (or override via Vercel env vars) and redeploy.
NEXT_PUBLIC_SUPABASE_URL=https://zpkaxojonufdwgahiqjh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ZMdilAOhHl1Y02oL_cTdfg_EjISP7fu
# Stripe publishable key (TEST) — browser-safe by design. Secret key lives in the
# Supabase Edge Function secret store, never in the client.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51TROIRLkm5tW1zQKQ1IGJvzQKjs4NSNA27X5QqdxtehYMHceIAlBOM0oHscmTV41IUqgFmrpFkbkLYbGY5xvRDbI00oHTa60yz

